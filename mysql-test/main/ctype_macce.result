#
# MDEV-41246 "Illegal mix of collations" on the mysql.user view
#
SET NAMES macce COLLATE macce_general_ci;
SELECT c FROM v_tailoring WHERE c='Y';
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (macce_general_ci,COERCIBLE) for operation '='
SELECT c FROM v_tailoring WHERE c<>'Y_';
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (macce_general_ci,COERCIBLE) for operation '<>'
SELECT c FROM v_tailoring WHERE c<>'Y+';
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (macce_general_ci,COERCIBLE) for operation '<>'
SET NAMES macce COLLATE macce_bin;
SELECT c FROM v_tailoring WHERE c='Y';
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (macce_bin,COERCIBLE) for operation '='
SET NAMES DEFAULT;
# End of 11.8 tests
