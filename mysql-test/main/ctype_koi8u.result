#
# MDEV-41246 "Illegal mix of collations" on the mysql.user view
#
SET NAMES koi8u COLLATE koi8u_general_ci;
SELECT c FROM v_tailoring WHERE c='Y';
c
Y
SELECT c FROM v_tailoring WHERE c<>'Y_';
c
Y
SELECT c FROM v_tailoring WHERE c<>'Y+';
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (koi8u_general_ci,COERCIBLE) for operation '<>'
SET NAMES koi8u COLLATE koi8u_bin;
SELECT c FROM v_tailoring WHERE c='Y';
ERROR HY000: Illegal mix of collations (latin1_swedish_ci,COERCIBLE) and (koi8u_bin,COERCIBLE) for operation '='
SET NAMES DEFAULT;
# End of 11.8 tests
